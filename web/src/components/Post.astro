---
import Attachment from "./Attachment.astro";
import { roomHref, tagHref } from "../lib/data.js";
import { renderMarkdown } from "../lib/markdown.js";

const { post, currentRoom } = Astro.props;
const otherRooms = post.rooms.filter((r) => r !== currentRoom);
---

<article class="post">
  <div class="meta">
    <span class="author">{post.author}</span>
    <a href={post.link} target="_blank" title="Open in Discord"><time datetime={post.date}>{post.date.slice(0, 10)}</time></a>
  </div>
  {(otherRooms.length > 0 || post.tags.length > 0) && (
    <ul class="tags">
      {otherRooms.map((r) => <li class="room"><a href={roomHref(r)}>{r}</a></li>)}
      {post.tags.map((t) => <li><a href={tagHref(t)}>{t}</a></li>)}
    </ul>
  )}
  {post.prose && <div class="prose" set:html={renderMarkdown(post.prose)} />}
  {post.attachments.length > 0 && (
    <div class="attachments">
      {post.attachments.map((a) => <Attachment attachment={a} />)}
    </div>
  )}
</article>
