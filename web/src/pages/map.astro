---
import Layout from "../layouts/Layout.astro";
import mapRooms from "../../../data/map.json";
import { byRoom, roomHref } from "../lib/data.js";

const boxArea = ([, , w, h]) => w * h;
// Rooms without a map sprite only have a position; they are drawn as a dot of this radius.
const MARKER_R = 0.3;

const rooms = mapRooms.map((room) => {
  const count = byRoom.get(room.name)?.length ?? 0;
  const [r, g, b] = room.color.map((c) => Math.round(c * 255));
  const unique = (list) => [...new Map(list.filter((b) => boxArea(b) > 0).map((b) => [b.join(), b])).values()];
  const boxes = unique(room.boxes);
  const label = boxes.reduce((a, b) => (boxArea(b) > boxArea(a) ? b : a), [room.x, room.y, 0, 0]);
  return { ...room, boxes, count, fill: `rgb(${r} ${g} ${b})`, label };
});

// Markers sharing a position are fanned out on a small circle around it.
const markers = new Map();
for (const room of rooms.filter((r) => r.boxes.length === 0)) {
  const key = `${room.x},${room.y}`;
  if (!markers.has(key)) markers.set(key, []);
  markers.get(key).push(room);
}
const markerPos = new Map();
for (const stack of markers.values()) {
  const spread = stack.length > 1 ? MARKER_R * 1.2 * stack.length / Math.PI : 0;
  stack.forEach((room, i) => {
    const angle = (2 * Math.PI * i) / stack.length;
    markerPos.set(room.name, [room.x + spread * Math.cos(angle), room.y + spread * Math.sin(angle)]);
  });
}

// Each box is drawn on its own: rooms without strats (not clickable) below rooms with strats, then
// largest first, so smaller boxes end up on top.
const shapes = rooms
  .flatMap((room) => (room.boxes.length ? room.boxes.map((box) => ({ room, box })) : [{ room }]))
  .sort(
    (a, b) =>
      (a.room.count > 0) - (b.room.count > 0) || (b.box ? boxArea(b.box) : 0) - (a.box ? boxArea(a.box) : 0),
  );

const PAD = 2;
const minX = Math.min(...rooms.map((r) => r.x));
const maxX = Math.max(...rooms.map((r) => r.x + r.w));
const minY = Math.min(...rooms.map((r) => r.y));
const maxY = Math.max(...rooms.map((r) => r.y + r.h));
// Map-data is y-up, SVG is y-down.
const viewBox = `${minX - PAD} ${-maxY - PAD} ${maxX - minX + 2 * PAD} ${maxY - minY + 2 * PAD}`;
---

<Layout title="Map" wide>
  <svg class="map" viewBox={viewBox}>
    {shapes.map(({ room, box }) => {
      const roomClass = ["room", { "has-strats": room.count }];
      const shape = box
        ? <rect x={box[0]} y={-(box[1] + box[3])} width={box[2]} height={box[3]} fill={room.fill} class:list={roomClass} />
        : <circle cx={markerPos.get(room.name)[0]} cy={-markerPos.get(room.name)[1]} r={MARKER_R} fill={room.fill} class:list={roomClass} />;
      const title = <title>{room.count ? `${room.name} · ${room.count} strats` : room.name}</title>;
      return room.count ? <a href={roomHref(room.name)}>{shape}{title}</a> : <g>{shape}{title}</g>;
    })}
    <g class="labels">
      {rooms.map(({ name, count, label: [x, y, w, h] }) => (
        <text x={x + w / 2} y={-(y + h / 2)} data-w={w} data-h={h} class:list={["label", { "has-strats": count }]}>{name}</text>
      ))}
    </g>
  </svg>
  <script>
    import { initMap } from "../scripts/map.js";

    function init() {
      const map = document.querySelector("svg.map");
      if (map && !map.dataset.ready) initMap(map);
    }
    // after-swap runs before the new page is painted; the direct call covers the first load of this module.
    document.addEventListener("astro:after-swap", init);
    init();
  </script>
</Layout>
