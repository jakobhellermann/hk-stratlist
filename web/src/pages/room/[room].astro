---
import Layout from "../../layouts/Layout.astro";
import Post from "../../components/Post.astro";
import { byRoom, roomTitle } from "../../lib/data.js";

export function getStaticPaths() {
  return [...byRoom.keys()].map((room) => ({ params: { room } }));
}

const { room } = Astro.params;
const posts = byRoom.get(room);
---

<Layout title={roomTitle(room)}>
  <h1>{roomTitle(room)}</h1>
  {posts.map((post) => <Post post={post} currentRoom={room} />)}
</Layout>
