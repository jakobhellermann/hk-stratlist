---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { gameData, games } from "../lib/data.js";

const { title, wide = false } = Astro.props;
const { game } = Astro.params;
const { gameUrl, updated } = gameData(game);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · #strats` : "#strats"}</title>
    <ClientRouter />
  </head>
  <body class:list={{ wide }}>
    <header>
      <a href={gameUrl("")}>#strats</a>
      <nav><a href={gameUrl("list/")}>List</a> <a href={gameUrl("tags/")}>Tags</a></nav>
      <time class="updated" datetime={updated}>Updated {updated.slice(0, 10)}</time>
      <nav class="games">
        {games.map(({ slug, label }) => (
          <a href={gameData(slug).gameUrl("")} title={label} aria-current={slug === game ? "page" : undefined}>
            <span class="long">{label}</span><span class="short">{slug.toUpperCase()}</span>
          </a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <script>
      import "../scripts/player.js";
      import "../scripts/spoiler.js";
    </script>
  </body>
</html>
