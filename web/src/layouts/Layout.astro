---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { url } from "../lib/url.js";
import { updated } from "../lib/data.js";

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · #strats` : "#strats"}</title>
    <ClientRouter />
  </head>
  <body class:list={{ wide }}>
    <header>
      <a href={url("")}>#strats</a>
      <nav><a href={url("list/")}>List</a> <a href={url("tags/")}>Tags</a></nav>
      <time class="updated" datetime={updated}>Updated {updated.slice(0, 10)}</time>
    </header>
    <main><slot /></main>
    <script>
      import "../scripts/player.js";
      import "../scripts/spoiler.js";
    </script>
  </body>
</html>
