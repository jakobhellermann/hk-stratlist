---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { url } from "../lib/url.js";

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Silk Strats` : "Silk Strats"}</title>
    <ClientRouter />
  </head>
  <body class:list={{ wide }}>
    <header>
      <a href={url("")}>Silk Strats</a>
      <nav><a href={url("")}>List</a> <a href={url("map/")}>Map</a> <a href={url("tags/")}>Tags</a></nav>
    </header>
    <main><slot /></main>
    <script>
      import "../scripts/player.js";
      import "../scripts/spoiler.js";
    </script>
  </body>
</html>
